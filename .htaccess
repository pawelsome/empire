Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# www -> bez www, http -> https (SSL kończy się na proxy MyDevil, port 443 widać w SERVER_PORT)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{SERVER_PORT} !^443$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# pliki repozytorium nie są częścią strony
RewriteRule ^(README\.md|\.nojekyll|ec_korona\.png)$ - [F,L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

AddType font/woff2 .woff2
AddType image/x-icon .ico

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml image/svg+xml image/x-icon
</IfModule>
